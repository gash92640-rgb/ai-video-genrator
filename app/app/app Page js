'use client'
import { useState } from 'react'
import { HfInference } from '@huggingface/inference'

export default function Home() {
  const [prompt, setPrompt] = useState('')
  const [loading, setLoading] = useState(false)
  const [videoUrl, setVideoUrl] = useState('')

  async function generateVideo() {
    setLoading(true)
    setVideoUrl('')
    try {
      const hf = new HfInference(process.env.NEXT_PUBLIC_HF_TOKEN)
      const result = await hf.textToVideo({
        inputs: prompt,
        model: 'ByteDance/AnimateDiff-Lightning'
      })
      setVideoUrl(URL.createObjectURL(result))
    } catch (e) {
      alert('Error: ' + e.message)
    }
    setLoading(false)
  }

  return (
    <main className="min-h-screen bg-black text-white p-8">
      <h1 className="text-4xl font-bold text-center mb-8">AI Video Generator</h1>
      <div className="max-w-2xl mx-auto">
        <input 
          className="w-full p-4 rounded-lg bg-gray-800 mb-4 text-white"
          placeholder="Video ka prompt likho... jaise: cat playing piano"
          value={prompt}
          onChange={(e) => setPrompt(e.target.value)}
        />
        <button 
          onClick={generateVideo}
          disabled={loading}
          className="w-full p-4 bg-purple-600 rounded-lg font-bold disabled:opacity-50"
        >
          {loading ? 'Generating...' : 'Generate Video'}
        </button>
        {videoUrl && (
          <video src={videoUrl} controls className="mt-8 w-full rounded-lg" />
        )}
      </div>
    </main>
  )
}
